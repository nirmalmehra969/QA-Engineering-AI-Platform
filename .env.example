# ─────────────────────────────────────────────────────────────────────────────
# AI-Powered QA Testing Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Flask server
PORT=5000
HOST=0.0.0.0
SECRET_KEY=your_secret_key_here

# ─── AI Provider ──────────────────────────────────────────────────────────────
#
#  AI_PROVIDER options:
#    gemini    → Use Google Gemini exclusively (requires GEMINI_API_KEY)
#    openai    → Use OpenAI exclusively (requires OPENAI_API_KEY)
#    hybrid    → Try Gemini first, then OpenAI, then Offline Heuristic
#    heuristic → Always use Offline Heuristic Engine (no key required)
#
AI_PROVIDER=gemini

# Google Gemini API key (get yours at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.8-flash

# OpenAI API key (optional, used only when AI_PROVIDER=openai or hybrid)
OPENAI_API_KEY=

# AI_FALLBACK_ENABLED:
#   true  → Fall back to Offline Heuristic Engine when Gemini/OpenAI fails
#   false → Return an error instead of silently falling back
AI_FALLBACK_ENABLED=true

# ─── Target Application ───────────────────────────────────────────────────────
TARGET_APP_URL=http://127.0.0.1:5000/app/target-store
ALLOW_EXTERNAL_URLS=false
